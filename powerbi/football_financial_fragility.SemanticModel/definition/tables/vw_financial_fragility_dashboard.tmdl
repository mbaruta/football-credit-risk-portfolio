table vw_financial_fragility_dashboard
	lineageTag: 29255dfb-1388-4014-afa4-e7d167577709

	measure 'Median Fragility Score' = MEDIAN(vw_financial_fragility_dashboard[financial_fragility_score])
		lineageTag: be0b7154-9e92-4a35-a026-82b04167b7d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Current Liquidity' = MEDIAN(vw_financial_fragility_dashboard[current_liquidity])
		lineageTag: 682342e9-16f1-4a0b-9857-b19b87eabcd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Liability Ratio' = MEDIAN(vw_financial_fragility_dashboard[liability_ratio])
		lineageTag: 7efa13e6-c400-4a65-8208-d375aff13d17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median ROA' = MEDIAN(vw_financial_fragility_dashboard[return_on_assets])
		lineageTag: 0e1b5f78-3edd-4944-bcae-7f1b91af9413

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Negative Equity Share' = ```
			DIVIDE(CALCULATE(
			        COUNTROWS(vw_financial_fragility_dashboard), 
			        vw_financial_fragility_dashboard[negative_equity] = TRUE()), 
			    COUNTROWS(vw_financial_fragility_dashboard))
			```
		formatString: 0%;-0%;0%
		lineageTag: 034adba3-a623-4bcb-9d1d-d1d602e19668

	measure 'Median Liquidity Risk' = MEDIAN(vw_financial_fragility_dashboard[liquidity_risk])
		lineageTag: 06d22369-6358-4177-965d-65a9cb03c904

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Solvency Risk' = MEDIAN(vw_financial_fragility_dashboard[solvency_risk])
		lineageTag: e63c2c42-fdf6-40bf-a8a2-248c0345ab20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Profitability Risk' = MEDIAN(vw_financial_fragility_dashboard[profitability_risk])
		lineageTag: 30c922be-7bd5-4f37-a65c-651c08a343de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Negative Equity Status' =
			
			IF(
			    ISBLANK(SELECTEDVALUE(vw_financial_fragility_dashboard[negative_equity])),
			    BLANK(),
			    IF(
			        SELECTEDVALUE(vw_financial_fragility_dashboard[negative_equity]),
			        "Yes",
			        "No"
			    )
			)
		lineageTag: 8859b6e6-df32-431e-b98a-b3cadd4d9b9d

	measure 'Year Median Fragility Score' =
			
			CALCULATE(
			    MEDIAN(vw_financial_fragility_dashboard[financial_fragility_score]),
			    REMOVEFILTERS(vw_financial_fragility_dashboard[club])
			)
		lineageTag: 895fdf12-e837-4f4e-b6dc-86b90bb396fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Difference vs Year Median' =
			
			SELECTEDVALUE(
			    vw_financial_fragility_dashboard[financial_fragility_score]
			)
			-
			[Year Median Fragility Score]
		lineageTag: cc8ce8bf-6c21-4677-93d7-eabdcdb0ca3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Low Liquidity Share' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(vw_financial_fragility_dashboard),
			        vw_financial_fragility_dashboard[current_liquidity] < 1
			    ),
			    COUNTROWS(vw_financial_fragility_dashboard)
			)
		formatString: 0%;-0%;0%
		lineageTag: 9273b8ba-a848-45d2-9838-6329a547a9ab

	measure 'Loss Share' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(vw_financial_fragility_dashboard),
			        vw_financial_fragility_dashboard[net_result] < 0
			    ),
			    COUNTROWS(vw_financial_fragility_dashboard)
			)
		formatString: 0%;-0%;0%
		lineageTag: dc47bbd8-daec-4a61-9d02-c8171f3024cd

